# Copy to .env and fill in. Only needed to rebuild data; the app itself needs none of these.
GFW_API_TOKEN=
FIRMS_MAP_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
SPACETRACK_USER=
SPACETRACK_PASS=

# Hosted chat on Netlify (OpenRouter). Paste your key after the = sign. Free models only by default.
OPENROUTER_API_KEY=
# Optional: comma-separated model ids, tried in order. Keep ":free" ids to pay nothing.
OPENROUTER_MODEL=
# Netlify personal access token (Netlify > User settings > Applications > Personal access tokens). Paste after the = sign.
NETLIFY_AUTH_TOKEN=
